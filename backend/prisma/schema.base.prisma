
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model images {
  id         String      @id @default(uuid())
  fileId    String
  url        String
  users      users[]
  agents    agents[] 
    createdAt     DateTime               @default(now())
  updatedAt     DateTime?               @updatedAt
}

model users {
  id            String                 @id @default(uuid())
  name          String
  email         String                 @unique
  role          String                 @default("user")
  password      String?
  following     String[]
  avatar        images?                @relation(fields: [imagesId], references: [id])
  agencyReviews agencyReviews[]
  imagesId      String?                
  followings    followers[]
  applications  propertyApplications[]
  propertyTransactions propertyTransactions[]

  createdAt     DateTime               @default(now())
  updatedAt     DateTime?               @updatedAt
}

model agencyReviews {
  id        String    @id @default(uuid())
  userId    String    
  user      users     @relation(fields: [userId], references: [id])
  rating    Float
  reviews   String?
  agencyId  String?   
  agencies  agencies? @relation(fields: [agencyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt
}

model agencyRoles {
  id          String @id @default(uuid())
  agencyId    String 
  name        String // Agent, Accountant, Lawyer, etc
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])

  permissions agencyRolePermissions[]
  members     agencyMembership[]
}

model agencyRolePermissions {
  id           String @id @default(uuid())
  roleId       String 
  permissionId String 

  role         agencyRoles @relation(fields: [roleId], references: [id])
  permission   permissions @relation(fields: [permissionId], references: [id])
}

model agencyMembership {
  id        String @id @default(uuid())

  agencyId  String 
  agentId   String 
  roleId    String 

  status    AgentStatus @default(ACTIVE)
  invitedById String? 

  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  agent  agents   @relation(fields: [agentId], references: [id])
  role   roles @relation(fields: [roleId], references: [id])
}

model agencyJoinRequests {
  id String @id @default(uuid())

  agencyId String 
  agentId  String 

  message String?

  status JoinRequestStatus @default(PENDING)

  reviewedById String? 
  reviewedAt   DateTime?

  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  agent  agents   @relation(fields: [agentId], references: [id])

  @@unique([agencyId, agentId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model agencyInvites {
  id        String @id @default(uuid())
  email     String
  token     String @unique

  agencyId  String 
  roleId    String 

  invitedById String 

  status    InviteStatus @default(PENDING)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  role   roles @relation(fields: [roleId], references: [id])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model followers {
  id String @id @default(uuid())

  userId   String 
  agencyId String 

  user     users     @relation(fields: [userId], references: [id])
  agencies agencies? @relation(fields: [agencyId], references: [id])

  @@unique([userId, agencyId]) // One user can follow the same agency only once
}

model agencies {
  id String @id @default(uuid())

  name           String
  bio            String?
  category       String
  operatingAreas String[]

  verified  Boolean   @default(false)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // 🔥 core relationship
  memberships agencyMembership[]

  // 1:1 splits — each owns its own task-completion concern
  contact         agencyContact?
  support         agencySupport?
  businessDetails agencyBusinessDetails?
  media           agencyMedia?

  // everything else unchanged
  followers   followers[]
  reviews     agencyReviews[]
  properties  properties[]
  invites     agencyInvites[]
  joinRequest agencyJoinRequests[]
  addresses   agencyAddresses[]

  documents    agencyDocuments?
  bankAccounts agencyBankAccounts[]

  agencyTaskProgress agencyTaskProgress[]
}

model agencyContact {
  id       String  @id @default(uuid())
  agencyId String  @unique
  email    String?
  phone    String?
  website  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model agencySupport {
  id           String  @id @default(uuid())
  agencyId     String  @unique
  supportEmail String?
  supportPhone String?
  openingHours String?   // moved here — "when can support reach you" fits better than agencyContact

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model agencyBusinessDetails {
  id                String   @id @default(uuid())
  agencyId          String   @unique
  commissionRate    Float?
  servicesOffered   String[]
  yearEstablished   Int?
  businessRegNumber String?
  taxId             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model agencyMedia {
  id          String  @id @default(uuid())
  agencyId    String  @unique
  avatar      String?
  coverBanner String?
  logoUrl     String?
  videoIntro  String?
  socialLinks Json[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model agencyAddresses {
  id        String           @id @default(uuid())
  agencyId  String           
  label     agencyddressType // e.g. "HEAD_OFFICE" | "BRANCH" | "WAREHOUSE"
  name      String
  street    String
  city      String
  zip       String
  state     String
  country   String
  isDefault Boolean          @default(true)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model agents {
  id          String @id @default(uuid())

  name        String
  email       String @unique
  phoneNumber String
  country     String
  password    String

  avatar    images? @relation(fields: [imagesId], references: [id])
  imagesId  String?

  isDeleted   Boolean @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  memberships agencyMembership[]

  joinRequest agencyJoinRequests[]
  properties properties[]
}

enum TaskTarget {
  AGENT
  AGENCY
}

enum TaskCategory {
  ONBOARDING
  PROFILE
  DOCUMENTS
  PROPERTY
  FINANCE
  CLIENTS
  MARKETING
  SALES
  TEAM
  ADVANCED
}

model tasks {
  id String @id @default(uuid())

  key         String       @unique   // ← stable slug, e.g. "CREATE_FIRST_PROPERTY"
  name        String
  description String
  target   TaskTarget
  category TaskCategory

  points        Int @default(10)
  rewardCredits Int @default(0)
  sortOrder Int

  isRequired Boolean @default(true)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agentProgress  agentTaskProgress[]
  agencyProgress agencyTaskProgress[]
}


model agentTaskProgress {
  id String @id @default(uuid())

  agentId String 
  taskId  String 
  completed   Boolean @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  agent agents @relation(fields: [agentId], references: [id])
  task  tasks  @relation(fields: [taskId], references: [id])

  @@unique([agentId, taskId])
}

model agencyTaskProgress {
  id String @id @default(uuid())

  agencyId String 
  taskId   String 
  completed   Boolean @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  agency agencies @relation(fields: [agencyId], references: [id])
  task   tasks    @relation(fields: [taskId], references: [id])

  @@unique([agencyId, taskId])
}


model agencyDocuments {
  id                  String    @id @default(uuid())
  agencyId            String    @unique 
  businessCertificate String? // CAC or business registration document
  proofOfAddress      String? // Utility bill / tenancy agreement
  ownerIdCard         String? // Government ID
  insuranceDocument   String? // Optional
  signedAgreement     String? // Digital or PDF signature file
  verifiedByAdmin     Boolean   @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime?  @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model agencyBankAccounts {
  id            String   @id @default(uuid())
  agencyId      String
  bankName      String
  accountName   String
  accountNumber String
  
  currencyId String  @default("NGN")
  currency   currencies @relation(fields: [currencyId], references: [code])

  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model roles {
  id          String        @id @default(uuid())
  key        String        @unique
  name        String        
  description String?
  isDefault   Boolean       @default(false) // Default roles like ADMIN, MANAGER, etc.
  permissions rolePermissions[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model permissions {
  id          String        @id @default(uuid())
  key        String        @unique
  name        String        
  description String?
  category    String?       // e.g. "Property", "Finance", "Agency"
  roles       rolePermissions[]
}

model rolePermissions {
  id            String       @id @default(uuid())
  roleId        String       
  permissionId  String       
  role          roles        @relation(fields: [roleId], references: [id])
  permission    permissions  @relation(fields: [permissionId], references: [id])
}

model site_config {
  id            String   @id @default(uuid())
  categories    String[]
  subCategories Json
  logo          String?
  banner        String?
}
enum DraftStatus {
  IN_PROGRESS
  READY
  PUBLISHED
  DISCARDED
}

model listingDrafts {
  id String @id @default(uuid())

  agencyId String
  agentId  String

  // If editing an existing live listing, link back to it. Null = brand new.
  listingId String? @unique

  // Whole form state as one flexible object. No per-field nullability
  // gymnastics, no partial-upsert branching — it's just "whatever the
  // agent has typed so far."
  data Json

  // For the multi-unit case: one draft can describe a whole complex plus
  // an array of units, instead of forcing 6 separate wizard runs.
  isMultiUnit Boolean @default(false)

  status       DraftStatus @default(IN_PROGRESS)
  lastSavedStep String?    // just a UI hint, not a gate — see below

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  agent  agents   @relation(fields: [agentId], references: [id])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model promotions {
  id          String  @id @default(uuid())
  name        String
  description String?

  discountType  DiscountType
  discountValue Float
  discountCode  String       @unique

  validFrom  DateTime?
  validUntil DateTime?
  usageLimit Int?
  usageCount Int       @default(0)

  isActive Boolean @default(true)

  // Scope stays at the PROPERTY (asset) level — "applies to everything
  // under this building." Listing-level promo scoping can be added later
  // as an optional listingId if you need per-offer discounts.
  agentId    String?
  agencyId   String
  propertyId String? // null = applies to all agency properties

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agent              agents?              @relation(fields: [agentId], references: [id])
  agency             agencies             @relation(fields: [agencyId], references: [id])
  property           properties?          @relation(fields: [propertyId], references: [id])
  creditTransactions creditTransactions[]
}

model amenities {
  id       String  @id @default(uuid())
  name     String  @unique
  category String
  icon     String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  units propertyUnitAmenities[]
}

// Amenities now attach to the UNIT (persist across relistings), not the listing.
model propertyUnitAmenities {
  id     String @id @default(uuid())
  unitId String
  amenityId String

  unit    propertyUnits @relation(fields: [unitId], references: [id])
  amenity amenities     @relation(fields: [amenityId], references: [id])

  @@unique([unitId, amenityId])
}

// ── ASSET ────────────────────────────────────────────────────────────────
// The physical building/land/complex. Address, location, ownership — never
// price or availability, since those live below on listings.
model properties {
  id          String  @id @default(uuid())
  title       String
  description String?

  video_url String?
  address   String?
  city      String?
  state     String?
  country   String?
  showTo    ShowAddress?

  latitude  Float?
  longitude Float?

  tags String[]

  isMultiUnit Boolean @default(false)

  // Legal/ownership verification of the ASSET itself (e.g. title deed
  // confirmed) — distinct from a listing being live/published, which is
  // covered by listings.status instead.
  verified   Boolean?  @default(false)
  verifiedAt DateTime?
  verifiedBy String?
  isDeleted  Boolean?  @default(false)
  deletedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agencyId String
  agency   agencies @relation(fields: [agencyId], references: [id])
  agentId  String?
  agent    agents?  @relation(fields: [agentId], references: [id])

  units propertyUnits[]

  nearByLocation    propertyNearbyPlaces[]
  documents         propertyDocuments[]
  promotions        promotions[]
  eventPropertyLink eventPropertyLink[]
}

// ── UNIT (physical space) ──────────────────────────────────────────────
// One leasable/saleable space. Always exists — even a standalone house is
// a property with exactly one unit. Physical characteristics live here,
// stable across however many times the unit gets relisted.
model propertyUnits {
  id         String     @id @default(uuid())
  propertyId String
  property   properties @relation(fields: [propertyId], references: [id])

  unitLabel String? // "Shop 3", "Flat 2B" — null for standalone (only) unit

  category             PropertyCategory?
  type                 PropertyType?
  designType           DesignType?
  purpose              PropertyPurpose?
  economicClass        EconomicClass?
  customSpecifications Json?
  customFeatures       Json?
  furnishing           FurnishingStatus?
  sizeSqm              Float?
  landSizeSqm          Float?
  yearBuilt            Int?
  condition            ConditionStatus?

  electricity      ElectricityType?
  electricBilling  MeterType?
  waterSupply      WaterSupplyType?
  cooling          CoolingType?
  heating          HeatingType?
  construction     ConstructionStatus?
  floorType        FloorType?
  roofType         RoofType?
  wallFinish       WallFinish?
  ceilingType      CeilingType?
  buildingMaterial BuildingMaterial?

  structureId String?            @unique
  structure   PropertyStructure? @relation(fields: [structureId], references: [id])

  images    PropertyImages[]
  videos    PropertyVideo[]
  amenities propertyUnitAmenities[]
  floorPlans floorPlan[]

  listings listings[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

// ── LISTING (the commercial offer) ───────────────────────────────────────
// "This unit is for rent/sale, right now, at this price." A unit can have
// many listings over its lifetime (relisted after each tenant leaves).
// Everything that "happens" to an offer — leasing, buying, inspecting,
// applying — points here.
enum ListingPurpose {
  RENT
  SALE
  LEASE
  SHORT_LET
}

enum ListingLifecycleStatus {
  DRAFT
  ACTIVE
  PENDING
  RENTED
  SOLD
  EXPIRED
  ARCHIVED
}

model listings {
  id String @id @default(uuid())

  slug String @unique

  unitId String
  unit   propertyUnits @relation(fields: [unitId], references: [id])

  purpose      ListingPurpose
  status       ListingLifecycleStatus @default(DRAFT)
  progressStep ListingStep            @default(BASIC_INFO)

  availability  AvailabilityStatus?
  availableFrom DateTime?

  ratings   Float? @default(0)
  views     Int?   @default(0)
  favorites Int?   @default(0)

  publishedAt DateTime?
  expiredAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  pricing              propertyPricing?
  propertyBoosts       propertyBoosts[]
  propertyAnalytics    propertyAnalytics?
  propertyTransactions propertyTransactions[]
  applications         propertyApplications[]
  leases               leases[]
  invoices             invoices[]
  propertyInspections  propertyInspections[]
}

enum ListingStep {
  BASIC_INFO
  STRUCTURE
  MEDIA
  PRICING
  REVIEW
}

model PropertyImages {
  id     String        @id @default(uuid())
  unitId String
  unit   propertyUnits @relation(fields: [unitId], references: [id])
  fileId String
  url    String
  caption String?
  type    String?
  isCover Boolean  @default(false)
  order   Int?     @default(0)
  createdAt DateTime @default(now())
}

model PropertyStructureLocale {
  id          String @id @default(uuid())
  structureId String
  countryCode String
  localName   String
  description String?
  examples    String[]

  structure PropertyStructure @relation(fields: [structureId], references: [id])
}

model PropertyStructure {
  id              String   @id @default(uuid())
  bedrooms        Int?
  bathrooms       Int?
  toilets         Int?
  livingRooms     Int?
  kitchens        Int?
  kitchenType     KitchenType?
  toiletLocation  ToiletLocation?
  isWholeBuilding Boolean?        @default(false)
  isServiced      Boolean?        @default(false)
  floorLevel      Int?
  hasBalcony      Boolean?        @default(false)
  petPolicy       PetPolicy?      @default(NOT_ALLOWED)
  petDetails      Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  unit                    propertyUnits?
  PropertyStructureLocale PropertyStructureLocale[]
}

enum KitchenType {
  PRIVATE
  SHARED
  OUTDOOR
}

enum ToiletLocation {
  INDOOR
  OUTDOOR
  SHARED
}

enum PetPolicy {
  NOT_ALLOWED
  ALLOWED
  NEGOTIABLE
  REQUIRES_APPROVAL
}

enum PricingFeeType {
  SECURITY_DEPOSIT
  AGENT_FEE
  APPLICATION_FEE
  LEGAL_FEE
  SERVICE_CHARGE
  STAMP_DUTY
  VAT
  OTHER
}

model propertyPricingFees {
  id        String   @id @default(uuid())
  pricingId String   @unique
  pricing   propertyPricing @relation(fields: [pricingId], references: [id])

  label    String? // for OTHER or country-specific naming, e.g. "Holding Deposit"
  type    PricingFeeType
  amount        Decimal @db.Decimal(14, 2)

}

model propertyPricing {
  id        String   @id @default(uuid())
  listingId String   @unique
  listing   listings @relation(fields: [listingId], references: [id])

  basePrice        Decimal @db.Decimal(14, 2)

  leaseTerm    LeaseTerm?
  paymentType      PropertyCategory?
  paymentFrequency PaymentFrequency?

  currencyId String  @default("NGN")
  currency   currencies @relation(fields: [currencyId], references: [code])

  negotiable       Boolean?          @default(false)

 fees propertyPricingFees[]
}

model PropertyVideo {
  id     String        @id @default(uuid())
  unitId String
  unit   propertyUnits @relation(fields: [unitId], references: [id])
  fileId String
  url    String
  thumbnail String?
  title     String?
  duration  Float?
  createdAt DateTime @default(now())
}

model propertyNearbyPlaces {
  id         String     @id @default(uuid())
  propertyId String
  name       String
  category   String
  distanceKm Float?
  property   properties @relation(fields: [propertyId], references: [id])
}

model floorPlan {
  id     String        @id @default(uuid())
  unitId String
  unit   propertyUnits @relation(fields: [unitId], references: [id])
  fileId String
  name        String?
  description String?
  imageUrl    String?
  layout      Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model propertyDocuments {
  id         String  @id @default(uuid())
  propertyId String? // building-wide docs (COFO, survey plan)
  name       String
  type       DocumentType
  url        String
  fileId     String
  uploadedById String?
  verified     Boolean?  @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  property   properties? @relation(fields: [propertyId], references: [id])
  uploadedBy agents?     @relation(fields: [uploadedById], references: [id])
}

enum DocumentType {
  COFO
  SURVEY_PLAN
  DEED
  ALLOCATION_LETTER
  BUILDING_PLAN
  TAX_RECEIPT
  OTHER
}

model userAnalytics {
  id              String   @id @default(uuid())
  userId          String   @unique
  country         String?
  city            String?
  device          String?
  lastVisited     DateTime
  actions         Json?
  recommendations Json?
  lastTrained     DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

// Now tracks engagement on the OFFER, not the physical space — a relisted
// unit starts fresh analytics, which is correct (new offer, new interest).
model propertyAnalytics {
  id           String   @id @default(uuid())
  listingId    String   @unique
  agencyId     String
  views        Int      @default(0)
  inquiries    Int      @default(0)
  saved        Int      @default(0)
  applications Int      @default(0)
  rents        Int      @default(0)
  sales        Int      @default(0)
  lastViewedAt DateTime

  boostedViews Int @default(0)
  boostedRents Int @default(0)
  boostedSales Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency  agencies @relation(fields: [agencyId], references: [id])
  listing listings @relation(fields: [listingId], references: [id])
}

model agencyAnalytics {
  id            String @id @default(uuid())
  totalVisitors Int    @default(0)

  countryStats Json?
  cityStats    Json?
  deviceStats  Json?

  lastVisitedAt DateTime

  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt
  agencies  agencies[]
}

model uniqueAgencyVisitors {
  id        String   @id @default(uuid())
  agencyId  String
  userId    String
  visitedAt DateTime @default(now())

  @@unique([agencyId, userId])
}

model propertyApplications {
  id        String @id @default(uuid())
  userId    String
  listingId String
  agencyId  String?

  userStatus    ApplicationUserStatus   @default(PENDING)
  agencyStatus  ApplicationAgencyStatus @default(PENDING)
  overallStatus ApplicationStatus       @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  user    users     @relation(fields: [userId], references: [id])
  listing listings  @relation(fields: [listingId], references: [id])
  agency  agencies? @relation(fields: [agencyId], references: [id])
  buyers  buyers?   @relation(fields: [buyersId], references: [id])
  buyersId String?
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  FORMER
}

model tenants {
  id       String       @id @default(uuid())
  agencyId String
  userId   String
  status   TenantStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  user   users    @relation(fields: [userId], references: [id])

  leases       leases[]
  transactions propertyTransactions[]
  invoices     invoices[]

  @@unique([agencyId, userId])
}

enum BuyerStatus {
  ACTIVE
  INACTIVE
  CONVERTED
}

model buyers {
  id       String      @id @default(uuid())
  agencyId String
  userId   String
  status   BuyerStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  user   users    @relation(fields: [userId], references: [id])

  transactions propertyTransactions[]
  applications propertyApplications[]

  @@unique([agencyId, userId])
}

enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum LeaseTermType {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model leases {
  id        String @id @default(uuid())
  listingId String
  agencyId  String
  agentId   String?
  tenantId  String

  startDate  DateTime
  endDate    DateTime
  rentAmount Decimal       @db.Decimal(14, 2)

  currencyId String  @default("NGN")
  currency   currencies @relation(fields: [currencyId], references: [code])

  termType   LeaseTermType @default(YEARLY)
  status     LeaseStatus   @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  listing   listings         @relation(fields: [listingId], references: [id])
  agency    agencies         @relation(fields: [agencyId], references: [id])
  agent     agents?          @relation(fields: [agentId], references: [id])
  tenant    tenants          @relation(fields: [tenantId], references: [id])
  agreement leaseAgreements?
  invoices  invoices[]
}

model leaseAgreements {
  id             String    @id @default(uuid())
  leaseId        String    @unique
  fileUrl        String?
  fileId         String?
  signedByTenant Boolean   @default(false)
  signedByAgency Boolean   @default(false)
  tenantSignedAt DateTime?
  agencySignedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  lease leases @relation(fields: [leaseId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model invoices {
  id        String  @id @default(uuid())
  agencyId  String
  tenantId  String?
  listingId String?
  leaseId   String?

  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(14, 2)
  
  currencyId String  @default("NGN")
  currency   currencies @relation(fields: [currencyId], references: [code])

  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  paidAt        DateTime?
  description   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency  agencies  @relation(fields: [agencyId], references: [id])
  tenant  tenants?  @relation(fields: [tenantId], references: [id])
  listing listings? @relation(fields: [listingId], references: [id])
  lease   leases?   @relation(fields: [leaseId], references: [id])
}

model address {
  id        String      @id @default(uuid())
  userId    String
  label     addressType
  name      String
  street    String
  city      String
  zip       String
  country   String
  isDefault Boolean     @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model notifications {
  id            String  @id @default(uuid())
  creatorId     String?
  receiverId    String
  redirect_link String?
  title         String
  message       String
  status        String  @default("Unread")
  type          String?
  channel       String?
  meta          Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model conversationGroup {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String?
  creatorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants participants[]
  message      message[]
}

model participants {
  id             String    @id @default(uuid())
  conversationId String
  userId         String?
  agentId        String?
  lastSeenAt     DateTime?
  isOnline       Boolean   @default(false)
  unreadCount    Int       @default(0)
  muted          Boolean   @default(false)
  joinedAt       DateTime  @default(now())

  conversation conversationGroup @relation(fields: [conversationId], references: [id])
}

model message {
  id String @id @default(uuid())

  conversationId String
  senderId       String
  senderType     String

  content     String?
  attachments String[]
  status      String   @default("sent")

  createdAt DateTime @default(now())

  conversation conversationGroup @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
}

enum EventType {
  AGENCY
  PROPERTY
  GLOBAL
}

enum EventStatus {
  DRAFT
  ACTIVE
  ENDED
  UPCOMING
  SUSPENDED
  TERMINATED
}

enum PlatformType {
  WEB
  MOBILE
  BOTH
}

enum BoostTier {
  SILVER
  GOLD
  PLATINUM
}

enum CreditType {
  EARNED
  SPENT
  PURCHASED
  REFUNDED
  TASK_REWARD
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

model marketingEvents {
  id             String         @id @default(uuid())
  title          String
  description    String?
  platforms      PlatformType[] @default([WEB, MOBILE])
  showOnHomepage Boolean        @default(false)
  startDate      DateTime
  endDate        DateTime
  status         EventStatus    @default(ACTIVE)
  pointsUsed     Int            @default(0)
  type           EventType

  agencyId String?
  adminId  String?

  agency        agencies?            @relation(fields: [agencyId], references: [id])
  admin         admins?              @relation(fields: [adminId], references: [id])
  images        eventImages[]
  transactions  creditTransactions[]
  propertyLinks eventPropertyLink[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

// Marketing events still link at the PROPERTY (asset) level — promoting
// "Ikeja City Mall" as a whole, not one specific shop's offer. If you need
// to promote a specific listing later, add a parallel eventListingLink.
model eventPropertyLink {
  id         String @id @default(uuid())
  eventId    String
  propertyId String

  marketingEvent marketingEvents @relation(fields: [eventId], references: [id])
  property       properties      @relation(fields: [propertyId], references: [id])
}

model eventImages {
  id       String           @id @default(uuid())
  fileId   String
  url      String
  eventId  String?
  event    marketingEvents? @relation(fields: [eventId], references: [id])
  platform PlatformType?

  createdAt DateTime @default(now())
}

model propertyBoosts {
  id        String @id @default(uuid())
  agencyId  String
  listingId String
  tier          BoostTier
  creditsSpent  Int         @default(0)
  startTime     DateTime    @default(now())
  endTime       DateTime
  status        BoostStatus @default(PENDING)
  priorityScore Int

  agency             agencies             @relation(fields: [agencyId], references: [id])
  listing            listings             @relation(fields: [listingId], references: [id])
  createdAt          DateTime             @default(now())
  creditTransactions creditTransactions[]
}

model agencyCredits {
  id          String   @id @default(uuid())
  agencyId    String   @unique
  balance     Int      @default(0)
  lastUpdated DateTime @default(now())

  agency       agencies             @relation(fields: [agencyId], references: [id])
  transactions creditTransactions[]
  createdAt    DateTime             @default(now())
}

model creditTransactions {
  id            String     @id @default(uuid())
  agencyId      String
  type          CreditType
  amount        Int        // credits, not currency — matches balance's Int type
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  purpose       String?
  note          String?
  eventId       String?
  boostId       String?
  promotionId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  agency         agencies         @relation(fields: [agencyId], references: [id])
  marketingEvent marketingEvents? @relation(fields: [eventId], references: [id])
  propertyBoost  propertyBoosts?  @relation(fields: [boostId], references: [id])
  promotion      promotions?      @relation(fields: [promotionId], references: [id])
}

model creditSettings {
  id            String  @id @default(uuid())
  action        String
  tier          String?
  cost          Int
  currencyValue Float?  @default(0)
  description   String?
  isActive      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model admins {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  password  String
  status    AdminStatus @default(PENDING)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt

  roleLinks adminRoleLink[]
  logs      adminActivityLogs[]
  events    marketingEvents[]
}

model adminRoleLink {
  id      String     @id @default(uuid())
  adminId String
  roleId  String
  admin   admins     @relation(fields: [adminId], references: [id])
  role    adminRoles @relation(fields: [roleId], references: [id])
}

model adminRoles {
  id              String               @id @default(uuid())
  name            String               @unique
  description     String?
  permissionLinks rolePermissionLink[]
  roleLinks       adminRoleLink[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime?            @updatedAt
}

model adminPermissions {
  id              String               @id @default(uuid())
  code            String               @unique
  description     String?
  permissionLinks rolePermissionLink[]
}

model rolePermissionLink {
  id           String           @id @default(uuid())
  roleId       String
  permissionId String
  role         adminRoles       @relation(fields: [roleId], references: [id])
  permission   adminPermissions @relation(fields: [permissionId], references: [id])
}

model adminActivityLogs {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  targetId    String?
  targetType  String?
  description String?
  createdAt   DateTime @default(now())

  admin admins @relation(fields: [adminId], references: [id])
}

model propertyTransactions {
  id        String           @id @default(uuid())
  type      PropertyCategory @default(RENT)
  userId    String
  listingId String
  agencyId  String
  startDate DateTime?
  endDate   DateTime?
  amount    Decimal?  @db.Decimal(14, 2)
  

  currencyId String  @default("NGN")
  currency   currencies @relation(fields: [currencyId], references: [code])

  paymentRef String?
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime?   @updatedAt

  tenantId String?
  buyerId  String?
  tenant   tenants? @relation(fields: [tenantId], references: [id])
  buyer    buyers?  @relation(fields: [buyerId], references: [id])

  user    users    @relation(fields: [userId], references: [id])
  listing listings @relation(fields: [listingId], references: [id])
  agency  agencies @relation(fields: [agencyId], references: [id])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

model propertyMonitors {
  id            String            @id @default(uuid())
  userId        String
  name          String?
  location      String?
  minPrice      Float?
  maxPrice      Float?
  bedrooms      Int?
  bathrooms     Int?
  propertyType  String?
  category      PropertyCategory?
  frequency     NotifyFrequency   @default(IMMEDIATE)
  isActive      Boolean           @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user users @relation(fields: [userId], references: [id])
}

model nonitorNotifications {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  data      Json?
  channel   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model monitorSentHistory {
  id         String   @id @default(uuid())
  monitorId  String
  propertyId String
  sentAt     DateTime @default(now())

  @@index([monitorId, propertyId])
}

enum NotifyFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model propertyInspections {
  id        String @id @default(uuid())
  listingId String
  agencyId  String
  agentId   String?
  requestedById String?

  scheduledAt DateTime
  status      InspectionStatus @default(SCHEDULED)
  notes       String?
  feedback    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  listing listings @relation(fields: [listingId], references: [id])
  agency  agencies @relation(fields: [agencyId], references: [id])
  agent   agents?  @relation(fields: [agentId], references: [id])
}

model currencies {
  id        String @id @default(uuid())
  code String  @unique // ISO 4217, e.g. "NGN", "USD"
  name  String  // "United state Dollars"
  symbol   String? // "$"
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  pricing propertyPricing[]
  escrowPayments      escrowPayments[]
  agencyBankAccounts      agencyBankAccounts[]
  propertyTransactions      propertyTransactions[]
  invoices    invoices[]
  leases    leases[]
}

enum EscrowStatus {
  PENDING_PAYMENT
  HELD
  RELEASED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum EscrowPurpose {
  INSPECTION_FEE
  RENT_PAYMENT
  PURCHASE_PAYMENT
  CAUTION_FEE
  SERVICE_CHARGE
}

model escrowPayments {
  id        String @id @default(uuid())
  purpose EscrowPurpose
  status EscrowStatus
  flwTransactionId String? @unique // Flutterwave's numeric transaction id — needed for settle/refund calls

  amount Decimal @db.Decimal(14, 2)

  currencyId String  @default("NGN")
  currency   currencies @relation(fields: [currencyId], references: [code])

  payerId String
  payer      users @relation(fields: [payerId], references: [id])
  agencyId String
  agency      agencies @relation(fields: [agencyId], references: [id])
  
  listingId String?
  listing      listings? @relation(fields: [listingId], references: [id])
  inspectionId String?
  inspection      propertyInspections? @relation(fields: [inspectionId], references: [id])
  leaseId String?
  lease      leases? @relation(fields: [leaseId], references: [id])

  paymentRef String? @unique
  gatewayName String? @default("flutterwave")
  paidAt     DateTime?
  releasedAt DateTime?
  refundedAt DateTime?

  payerConfirmedAt DateTime?
  agencyConfirmedAt DateTime?
  autoReleaseAt DateTime? // set on HELD - cron release if unconfirmed by this date
  
  disputeReason String?
  disputedAt DateTime?
  resolvedBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}
model agencyWallets {
  id         String  @id @default(uuid())
  agencyId   String
  currencyId String
  balance    Decimal @db.Decimal(14, 2) @default(0)

  agency   agencies   @relation(fields: [agencyId], references: [id])
  currency currencies @relation(fields: [currencyId], references: [code])

  transactions walletTransactions[]
  withdrawals  withdrawals[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([agencyId, currencyId])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model walletTransactions {
  id String @id @default(uuid())

  walletId String
  wallet   agencyWallets @relation(fields: [walletId], references: [id])

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  amount        Decimal @db.Decimal(14, 2)
  balanceBefore Decimal @db.Decimal(14, 2)
  balanceAfter  Decimal @db.Decimal(14, 2)

  reference String? @unique
  purpose   String? // "ESCROW_RELEASE" | "WITHDRAWAL" | "WITHDRAWAL_REVERSAL"
  note      String?

  escrowPaymentId String?
  withdrawalId    String?

  createdAt DateTime @default(now())
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model withdrawals {
  id String @id @default(uuid())

  agencyId String
  agency   agencies @relation(fields: [agencyId], references: [id])

  walletId String
  wallet   agencyWallets @relation(fields: [walletId], references: [id])

  bankAccountId String
  bankAccount   agencyBankAccounts @relation(fields: [bankAccountId], references: [id])

  amount     Decimal @db.Decimal(14, 2)
  currencyId String
  currency   currencies @relation(fields: [currencyId], references: [code])

  status         WithdrawalStatus @default(PENDING)
  flwTransferId  String?          @unique
  failureReason  String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
}

enum InteractionType {
  VIEW
  SAVE
  INQUIRY
  APPLY
  RENT
  SALE
}

model userInteractions {
  id        String @id @default(uuid())
  userId    String
  listingId String
  type      InteractionType
  weight    Float // precomputed from type, avoids recomputing every training run

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([listingId])
}

model listingRecommendations {
  id        String @id @default(uuid())
  userId    String
  listingId String
  score     Float

  generatedAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, score])
}

model savedListings {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}