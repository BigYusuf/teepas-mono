
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model images {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  fileId    String
  url        String
  users      users[]
    createdAt     DateTime               @default(now())
  updatedAt     DateTime?               @updatedAt
}

model users {
  id            String                 @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String                 @unique
  role          String                 @default("user")
  password      String?
  following     String[]
  avatar        images?                @relation(fields: [imagesId], references: [id])
  agencyReviews agencyReviews[]
  imagesId      String?                @db.ObjectId
  followings    followers[]
  applications  propertyApplications[]
  propertyTransactions propertyTransactions[]

  createdAt     DateTime               @default(now())
  updatedAt     DateTime?               @updatedAt
}

model agencyReviews {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      users     @relation(fields: [userId], references: [id])
  rating    Float
  reviews   String?
  agencyId  String?   @db.ObjectId
  agencies  agencies? @relation(fields: [agencyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt
}

model agencyRoles {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String @db.ObjectId
  name        String // Agent, Accountant, Lawyer, etc
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])

  permissions agencyRolePermissions[]
  members     agencyMembership[]
}

model agencyRolePermissions {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String @db.ObjectId
  permissionId String @db.ObjectId

  role         agencyRoles @relation(fields: [roleId], references: [id])
  permission   permissions @relation(fields: [permissionId], references: [id])
}

model agencyMembership {
  id        String @id @default(auto()) @map("_id") @db.ObjectId

  agencyId  String @db.ObjectId
  agentId   String @db.ObjectId
  roleId    String @db.ObjectId

  status    AgentStatus @default(ACTIVE)
  invitedById String? @db.ObjectId

  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  agent  agents   @relation(fields: [agentId], references: [id])
  role   roles @relation(fields: [roleId], references: [id])
}

model agencyInvites {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String @unique

  agencyId  String @db.ObjectId
  roleId    String @db.ObjectId

  invitedById String @db.ObjectId

  status    InviteStatus @default(PENDING)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
  role   roles @relation(fields: [roleId], references: [id])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model followers {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId   String @db.ObjectId
  agencyId String @db.ObjectId

  user     users     @relation(fields: [userId], references: [id])
  agencies agencies? @relation(fields: [agencyId], references: [id])

  @@unique([userId, agencyId]) // One user can follow the same agency only once
}

model agencies {
  id                String @id @default(auto()) @map("_id") @db.ObjectId

  name              String
  bio               String?
  category          String

  operatingAreas    String[]
  website           String?
  email             String?
  phone             String?
  supportEmail      String?
  openingHours      String?

  commissionRate    Float?
  servicesOffered   String[]
  yearEstablished   Int?
  businessRegNumber String?
  taxId             String?

  verified          Boolean @default(false)
  isDeleted         Boolean @default(false)
  deletedAt         DateTime?

  step              String @default("incomplete")
  currentStep       Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  avatar      String?
  coverBanner String?
  logoUrl     String?
  videoIntro  String?
  socialLinks Json[]

  // 🔥 core relationship
  memberships agencyMembership[]

  // everything else unchanged
  followers followers[]
  reviews agencyReviews[]
  properties properties[]

  invites agencyInvites[]
  addresses agencyAddresses[]

  documents agencyDocuments?
  bankAccounts agencyBankAccounts[]
}

model agencyAddresses {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String           @db.ObjectId
  label     agencyddressType // e.g. "HEAD_OFFICE" | "BRANCH" | "WAREHOUSE"
  name      String
  street    String
  city      String
  zip       String
  state     String
  country   String
  isDefault Boolean          @default(true)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model agents {
  id          String @id @default(auto()) @map("_id") @db.ObjectId

  name        String
  email       String @unique
  phoneNumber String
  country     String
  password    String

  isDeleted   Boolean @default(false)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  memberships agencyMembership[]

  properties properties[]
}
enum TaskCategory {
  ONBOARDING
  PROFILE
  DOCUMENTS
  PROPERTY
  FINANCE
  CLIENTS
  MARKETING
  SALES
  TEAM
  ADVANCED
}

model tasks {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String
  category      TaskCategory
  points        Int          @default(10)
  rewardCredits Int          @default(0)
  sortOrder     Int
  isRequired    Boolean      @default(true)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  agentProgress agentTaskProgress[]
}

model agentTaskProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  agentId     String   @db.ObjectId
  taskId      String   @db.ObjectId
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  agent       agents   @relation(fields: [agentId], references: [id])
  task        tasks    @relation(fields: [taskId], references: [id])

  /// 🔥 Prevent duplicate agent-task assignments
  @@unique([agentId, taskId])
}

model agencyDocuments {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  agencyId            String    @unique @db.ObjectId
  businessCertificate String? // CAC or business registration document
  proofOfAddress      String? // Utility bill / tenancy agreement
  ownerIdCard         String? // Government ID
  insuranceDocument   String? // Optional
  signedAgreement     String? // Digital or PDF signature file
  verifiedByAdmin     Boolean   @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime?  @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model agencyBankAccounts {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId      String   @db.ObjectId
  bankName      String
  accountName   String
  accountNumber String
  currency      String   @default("NGN")
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt

  agency agencies @relation(fields: [agencyId], references: [id])
}

model roles {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  key        String        @unique
  name        String        
  description String?
  isDefault   Boolean       @default(false) // Default roles like ADMIN, MANAGER, etc.
  permissions rolePermissions[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model permissions {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  key        String        @unique
  name        String        
  description String?
  category    String?       // e.g. "Property", "Finance", "Agency"
  roles       rolePermissions[]
}

model rolePermissions {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  roleId        String       @db.ObjectId
  permissionId  String       @db.ObjectId
  role          roles        @relation(fields: [roleId], references: [id])
  permission    permissions  @relation(fields: [permissionId], references: [id])
}

model site_config {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categories    String[]
  subCategories Json
  logo          String?
  banner        String?
}

model promotions {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  public_name   String
  discountType  String
  discountValue Float
  discountCode  String   @unique
  agentId       String   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt
}

model properties {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String           @unique
  description   String?
  category      PropertyCategory?
  type          PropertyType?
  designType    DesignType?
  purpose       PropertyPurpose?
  economicClass EconomicClass?
  customSpecifications Json?
  customFeatures       Json?

  tags                 String[]
  furnishing           FurnishingStatus?
  sizeSqm              Float?
  landSizeSqm          Float?
  yearBuilt            Int?
  condition            ConditionStatus?
  availableFrom        DateTime?

  video_url            String?
  address              String?
  city                 String?
  state                String?
  country              String?
  showTo               ShowAddress?

  // Location coordinates
  coordinates             Json?

  // Property stats
  ratings              Float? @default(0)
  views                Int?   @default(0)
  favorites            Int?   @default(0)

  // Structure — now related
  structureId          String? @unique @db.ObjectId
  structure            PropertyStructure? @relation(fields: [structureId], references: [id])

  // Utilities & materials
  electricity          ElectricityType?
  electricBilling      MeterType?
  waterSupply          WaterSupplyType?
  cooling              CoolingType?
  heating              HeatingType?
  construction         ConstructionStatus?
  availability         AvailabilityStatus?
  floorType            FloorType?
  roofType             RoofType?
  wallFinish           WallFinish?
  ceilingType          CeilingType?
  buildingMaterial     BuildingMaterial?
  amenities            String[]
  nearByLocation       String[]

  // Status
  status               ListingStatus @default(DRAFT)
  progressStep         Int           @default(1) // 1–5 depending on step
    isPublished     Boolean       @default(false)
  verified             Boolean? @default(false)
  verifiedAt           DateTime?
  verifiedBy           String? @db.ObjectId
  isDeleted            Boolean? @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt

  // Relations
  images               PropertyImages[]
  documents            propertyDocuments[]
  pricing              propertyPricing?
  floorPlans           floorPlan[]
  propertyBoosts       propertyBoosts[]
  propertyAnalytics    propertyAnalytics?
  propertyTransactions propertyTransactions[]
  applications         propertyApplications[]

  agencyId             String   @db.ObjectId
  agency               agencies @relation(fields: [agencyId], references: [id])

  agentId              String?  @db.ObjectId
  agent                agents?  @relation(fields: [agentId], references: [id])
}
model PropertyImages {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId  String   @db.ObjectId
  property    properties @relation(fields: [propertyId], references: [id])
  fileId     String   // from ImageKit or Cloudinary
  url         String
  caption     String?
  type        String?  // e.g. INTERIOR, EXTERIOR
  isCover     Boolean  @default(false)
  order       Int?     @default(0)
  createdAt   DateTime @default(now())
}
model PropertyStructureLocale {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  structureId     String   @db.ObjectId
  countryCode     String   // e.g. "NG", "US", "UK"
  localName       String   // e.g. "Self Contain", "Studio"
  description     String?
  examples        String[]

  structure       PropertyStructure @relation(fields: [structureId], references: [id])
}

model PropertyStructure {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  bedrooms        Int?      // Number of bedrooms
  bathrooms       Int?      
  toilets         Int?      
  livingRooms     Int?
  kitchens        Int?
  kitchenType     KitchenType?  // PRIVATE, SHARED, OUTDOOR
  toiletLocation  ToiletLocation? // INDOOR, OUTDOOR, SHARED
  isWholeBuilding Boolean? @default(false)
  isServiced      Boolean? @default(false)
  floorLevel      Int?       // e.g., 1st floor, 2nd floor (for apartments)
  hasBalcony      Boolean? @default(false)
  petPolicy       PetPolicy? @default(NOT_ALLOWED)
  petDetails      Json?      // e.g. { type: "dog", allowed: false, fee: 5000 }

  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt

  // relations
  property        properties?
}
enum KitchenType {
  PRIVATE
  SHARED
  OUTDOOR
}

enum ToiletLocation {
  INDOOR
  OUTDOOR
  SHARED
}

enum PetPolicy {
  NOT_ALLOWED
  ALLOWED
  NEGOTIABLE
  REQUIRES_APPROVAL
}

model propertyPricing {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String   @unique @db.ObjectId
  basePrice     Float
  cautionFee    Float?       // security deposit
  agentFee      Float?       // commission or agency charge
  legalFee      Float?       // optional
  serviceCharge Float?       // optional
  paymentType   PropertyCategory? // e.g. RENT, SALE, LEASE
  paymentFrequency PaymentFrequency?
  leaseTerm     LeaseTerm?
  currency      String? @default("NGN")
  negotiable    Boolean? @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt

  property      properties @relation(fields: [propertyId], references: [id])
}

model PropertyVideo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId  String   @db.ObjectId
  property    properties @relation(fields: [propertyId], references: [id])
  fileId     String   // from ImageKit / Cloudinary
  url         String
  thumbnail   String?
  title       String?
  duration    Float?
  createdAt   DateTime @default(now())
}
model floorPlan {
   id           String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String    @db.ObjectId
  property    properties  @relation(fields: [propertyId], references: [id])
  fileId     String
  name        String?    // e.g., "Ground Floor", "3-Bedroom Layout"
  description String?    // Optional details
  imageUrl    String?    // Link to image or PDF (Cloudinary, S3, etc.)
  layout      Json?      // Optional structured data { bedrooms: 3, bathrooms: 2 }

  createdAt   DateTime   @default(now())
  updatedAt   DateTime?   @updatedAt
}

model propertyDocuments {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String?  @db.ObjectId
  name         String            // e.g. "Certificate of Occupancy"
  type         DocumentType      // enum, e.g. COFO, SURVEY, DEED, ALLOCATION, OTHERS
  url          String            // file URL (e.g., from Cloudinary)
    fileId     String
  uploadedById String?  @db.ObjectId
  verified     Boolean? @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt

  // relations
  property     properties? @relation(fields: [propertyId], references: [id])
  uploadedBy   agents?     @relation(fields: [uploadedById], references: [id])
}
enum DocumentType {
  COFO           // Certificate of Occupancy
  SURVEY_PLAN
  DEED
  ALLOCATION_LETTER
  BUILDING_PLAN
  TAX_RECEIPT
  OTHER
}

model userAnalytics {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique
  country         String?
  city            String?
  device          String?
  lastVisited     DateTime
  actions         Json?
  recommendations Json?
  lastTrained     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model propertyAnalytics {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId   String   @unique @db.ObjectId
  agencyId     String   @db.ObjectId
  views        Int      @default(0)
  inquiries    Int      @default(0)
  saved        Int      @default(0)
  applications Int      @default(0)
  rents        Int      @default(0)
  sales        Int      @default(0)
  lastViewedAt DateTime

  boostedViews Int @default(0)
  boostedRents Int @default(0)
  boostedSales Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  agency   agencies   @relation(fields: [agencyId], references: [id])
  property properties @relation(fields: [propertyId], references: [id])
}

model agencyAnalytics {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  totalVisitors Int    @default(0)

  countryStats Json? // Store aggregated country data { "US": 20, "IN": 50, "UK": 15 }
  cityStats    Json? // Store aggregated city data { "New York": 10, "Delhi": 25 }
  deviceStats  Json? // Store aggregated device data { "Mobile": 50, "Desktop": 30 }

  lastVisitedAt DateTime

  createdAt DateTime   @default(now())
  updatedAt DateTime?   @updatedAt
  agencies  agencies[]
}

model uniqueAgencyVisitors {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agencyId  String   @db.ObjectId
  userId    String   @db.ObjectId
  visitedAt DateTime @default(now())

  @@unique([agencyId, userId])
}

model propertyApplications {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String  @db.ObjectId
  propertyId String  @db.ObjectId
  agencyId   String? @db.ObjectId

  // New fields 👇
  userStatus    ApplicationUserStatus   @default(PENDING)
  agencyStatus  ApplicationAgencyStatus @default(PENDING)
  overallStatus ApplicationStatus       @default(PENDING)

 
  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt

  user     users      @relation(fields: [userId], references: [id])
  property properties @relation(fields: [propertyId], references: [id])
  agency   agencies?  @relation(fields: [agencyId], references: [id])
}

model address {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  label     addressType
  name      String
  street    String
  city      String
  zip       String
  country   String
  isDefault Boolean     @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt
}

model notifications {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  creatorId     String? //  @db.ObjectId
  receiverId    String
  redirect_link String?
  title         String
  message       String
  status        String  @default("Unread")
  type          String?
  channel   String?   // EMAIL | PUSH | IN_APP | SMS
  meta          Json?

  createdAt  DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model conversationGroup {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  isGroup        Boolean  @default(false)
  name           String?
  creatorId      String
  participantIds String[] @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt
}

model participant {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String    @db.ObjectId
  userId         String?   @db.ObjectId
  agentId        String?   @db.ObjectId
  lastSeenAt     DateTime?
  isOnline       Boolean   @default(false)
  unreadCount    Int       @default(0)
  muted          Boolean   @default(false)
  joinedAt       DateTime  @default(now())
}

model message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  senderId       String   @db.ObjectId
  senderType     String
  content        String?
  attachments    String[]
  status         String   @default("sent")
  createdAt      DateTime @default(now())

  @@unique([conversationId, senderId, content, createdAt])
}
// ----------------------
// ENUMS
// ----------------------
enum EventType {
  AGENCY
  PROPERTY
  GLOBAL
}

enum EventStatus {
  DRAFT
  ACTIVE
  ENDED
  UPCOMING
  SUSPENDED
  TERMINATED
}

enum PlatformType {
  WEB
  MOBILE
  BOTH
}

enum BoostTier {
  SILVER
  GOLD
  PLATINUM
}

enum CreditType {
  EARNED
  SPENT
  PURCHASED
  REFUNDED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

// ----------------------
// MARKETING EVENTS
// ----------------------
model marketingEvents {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  platforms       PlatformType[]      @default([WEB, MOBILE])
  showOnHomepage  Boolean             @default(false)
  startDate       DateTime
  endDate         DateTime
  status          EventStatus         @default(ACTIVE)
  pointsUsed      Int                 @default(0)
  type            EventType

  agencyId        String?             @db.ObjectId
  adminId         String?             @db.ObjectId

  agency          agencies?           @relation(fields: [agencyId], references: [id])
  admin           admins?             @relation(fields: [adminId], references: [id])
  images          eventImages[]
  transactions    creditTransactions[]
  propertyLinks   eventPropertyLink[] // explicit M2M

  createdAt       DateTime            @default(now())
  updatedAt       DateTime?            @updatedAt
}

// Explicit M2M join between marketingEvents and properties
model eventPropertyLink {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  eventId       String            @db.ObjectId
  propertyId    String            @db.ObjectId

  marketingEvent marketingEvents   @relation(fields: [eventId], references: [id])
  property       properties        @relation(fields: [propertyId], references: [id])
}

// ----------------------
// IMAGES
// ----------------------
model eventImages {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  fileId    String
  url        String
  eventId    String?            @db.ObjectId
  event      marketingEvents?   @relation(fields: [eventId], references: [id])
  platform   PlatformType?
 
  createdAt DateTime  @default(now())
}

// ----------------------
// PROPERTY BOOSTS
// ----------------------
model propertyBoosts {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  agencyId      String         @db.ObjectId
  propertyId    String         @db.ObjectId
  tier          BoostTier
  creditsSpent  Int            @default(0)
  startTime     DateTime       @default(now())
  endTime       DateTime
  status        BoostStatus    @default(PENDING)
  priorityScore Int

  agency        agencies       @relation(fields: [agencyId], references: [id])
  property      properties     @relation(fields: [propertyId], references: [id])
  createdAt      DateTime            @default(now())
}

// ----------------------
// AGENCY CREDITS
// ----------------------
model agencyCredits {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  agencyId    String               @unique @db.ObjectId
  balance     Int                  @default(0)
  lastUpdated DateTime             @default(now())

  agency      agencies             @relation(fields: [agencyId], references: [id])
  transactions creditTransactions[]
  createdAt      DateTime            @default(now())
}

model creditTransactions {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  agencyId       String              @db.ObjectId
  type           CreditType
  amount         Float
  balanceBefore  Float
  balanceAfter   Float
  reference      String?
  purpose        String?
  note           String?
  eventId        String?             @db.ObjectId
  boostId        String?             @db.ObjectId
  promotionId    String?             @db.ObjectId

  createdAt DateTime  @default(now())
  updatedAt DateTime?  @updatedAt
  
  agency          agencies           @relation(fields: [agencyId], references: [id])
  marketingEvent  marketingEvents?   @relation(fields: [eventId], references: [id])
  propertyBoost   propertyBoosts?    @relation(fields: [boostId], references: [id])
  promotion       promotions?        @relation(fields: [promotionId], references: [id])
}

model creditSettings {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  action        String                       // e.g. "BOOST_PROPERTY", "SEARCH_PROPERTY", "POST_PROPERTY"
  tier          String?                      // e.g. "BRONZE", "SILVER", "GOLD" or "BASIC", "PREMIUM"
  cost          Int                           // number of credits to deduct
  currencyValue Float?     @default(0)        // optional: real money equivalent (e.g., 10 credits = 1 USD)
  description   String?
  isActive      Boolean     @default(true)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime?    @updatedAt
}

// ----------------------
// ADMINS, ROLES & PERMISSIONS
// ----------------------
model admins {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String             @unique
  password    String
  status      AdminStatus        @default(PENDING)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime?               @updatedAt

  roleLinks   adminRoleLink[]
  logs        adminActivityLogs[]
  events      marketingEvents[]
}

// explicit join: Admin ↔ Role
model adminRoleLink {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String       @db.ObjectId
  roleId    String       @db.ObjectId
  admin     admins       @relation(fields: [adminId], references: [id])
  role      adminRoles   @relation(fields: [roleId], references: [id])
}

model adminRoles {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  name        String                @unique
  description String?
  permissionLinks rolePermissionLink[]
  roleLinks   adminRoleLink[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime?              @updatedAt
}

model adminPermissions {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  code         String                @unique
  description  String?
  permissionLinks rolePermissionLink[]
}

// explicit join: Role ↔ Permission
model rolePermissionLink {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  roleId        String             @db.ObjectId
  permissionId  String             @db.ObjectId
  role          adminRoles         @relation(fields: [roleId], references: [id])
  permission    adminPermissions   @relation(fields: [permissionId], references: [id])
}

// ----------------------
// ADMIN LOGS
// ----------------------
model adminActivityLogs {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String     @db.ObjectId
  action      String
  targetId    String?
  targetType  String?
  description String?
  createdAt   DateTime   @default(now())

  admin       admins     @relation(fields: [adminId], references: [id])
}


model propertyTransactions {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  type         PropertyCategory   @default(RENT)
  userId       String         @db.ObjectId
  propertyId   String         @db.ObjectId
  agencyId     String         @db.ObjectId
  startDate    DateTime?
  endDate      DateTime?
  amount       Float?
  paymentRef   String?
  status       OrderStatus    @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?       @updatedAt

  user         users          @relation(fields: [userId], references: [id])
  property     properties     @relation(fields: [propertyId], references: [id])
  agency       agencies       @relation(fields: [agencyId], references: [id])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}
model propertyMonitors {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  name          String?   // optional friendly name
  location      String?
  minPrice      Float?
  maxPrice      Float?
  bedrooms      Int?
  bathrooms     Int?
  propertyType  String?
  category      PropertyCategory? // RENT, SALE, etc.
  frequency     NotifyFrequency     @default(IMMEDIATE) // IMMEDIATE / DAILY / WEEKLY
  isActive      Boolean   @default(true)
  lastCheckedAt DateTime? // used by cron to only fetch new properties
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user users @relation(fields: [userId], references: [id])
}

model nonitorNotifications {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  message   String
  data      Json?
  channel   String   // EMAIL | PUSH | IN_APP | SMS
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model monitorSentHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  monitorId   String   @db.ObjectId
  propertyId  String   @db.ObjectId
  sentAt      DateTime @default(now())

  @@index([monitorId, propertyId])
}

enum NotifyFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
}
