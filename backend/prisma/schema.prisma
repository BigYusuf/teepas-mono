enum AgentRole {
  OWNER
  ADMIN
  MEMBER
}

//agency
enum ApplicationAgencyStatus {
  PENDING
  INSPECTION_APPROVED
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum BoostStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum EventSliderStatus {
  BOOKED
  ACTIVE
  EXPIRED
}

enum EventSliderSlot {
  HOME_SLIDER_1
  HOME_SLIDER_2
  HOME_SLIDER_3
  HOME_SLIDER_4
  HOME_SLIDER_5
