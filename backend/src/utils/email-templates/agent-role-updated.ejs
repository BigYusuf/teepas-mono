<!DOCTYPE html>
<html>
  <head>
    <title>Teepas - Your Role Has Been Updated</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        background-color: #fafafa;
        color: #222222;
      }
      a {
        color: #0070f3;
        text-decoration: none;
      }
      h1 {
        font-size: 24px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 15px;
        text-align: center;
      }
      p {
        margin-top: 0;
        margin-bottom: 24px;
      }
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
      }
      .email-header {
        background-color: #0070f3;
        padding: 24px;
        color: #ffffff;
      }
      .email-body {
        padding: 24px;
        background-color: #ffffff;
      }
      .email-footer {
        background-color: #f6f6f6;
        padding: 24px;
        text-align: center;
      }
      .button {
        display: inline-block;
        background-color: #0070f3;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 4px;
      }
      .highlight {
        font-weight: bold;
        color: #0070f3;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>Your Role Has Been Updated</h1>
      </div>

      <div class="email-body">
        <p>Hello <%= name %>,</p>

        <p>
          Your role in the agency
          <span class="highlight"><%= agencyName %></span> has been updated to
          <span class="highlight"><%= newRole %></span>.
        </p>

        <p>
          This change was made by
          <span class="highlight"><%= changedBy %></span>. You now have access
          to the permissions associated with your new role.
        </p>

        <p style="text-align: center;">
          <a href="https://teepas.com/dashboard" class="button">View Dashboard</a>
        </p>

        <p>
          If you believe this change was made in error, please contact your
          agency admin or reach out to our support team.
        </p>
      </div>

      <div class="email-footer">
        <p>
          Need help? Contact us at
          <a href="mailto:support@teepas.com">support@teepas.com</a>
        </p>
      </div>
    </div>
  </body>
</html>
