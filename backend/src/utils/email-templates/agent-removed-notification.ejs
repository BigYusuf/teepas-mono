<!DOCTYPE html>
<html>
  <head>
    <title>Teepas - Agent Removed Notification</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        background-color: #fafafa;
        color: #222222;
      }
      a {
        color: #0070f3;
        text-decoration: none;
      }
      h1 {
        font-size: 24px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 15px;
        text-align: center;
      }
      p {
        margin-top: 0;
        margin-bottom: 24px;
      }
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
      }
      .email-header {
        background-color: #0070f3;
        padding: 24px;
        color: #ffffff;
      }
      .email-body {
        padding: 24px;
        background-color: #ffffff;
      }
      .email-footer {
        background-color: #f6f6f6;
        padding: 24px;
        text-align: center;
      }
      .button {
        display: inline-block;
        background-color: #0070f3;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 4px;
      }
      .highlight {
        font-weight: bold;
        color: #0070f3;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>Agent Removed</h1>
      </div>

      <div class="email-body">
        <p>Hello <%= name %>,</p>

        <p>
          The agent <span class="highlight"><%= agentName %></span> was removed
          from your agency <span class="highlight"><%= agencyName %></span> by
          <span class="highlight"><%= removedBy %></span> on
          <span class="highlight"><%= date %></span>.
        </p>

        <p>
          You can review your staff records and permissions in your agency
          dashboard.
        </p>

        <p style="text-align: center">
          <a href="https://teepas.com/dashboard/agency/staff" class="button"
            >Manage Staff</a
          >
        </p>

        <p>
          If this removal was not authorized, please review access roles or
          contact Teepas Support immediately.
        </p>
      </div>

      <div class="email-footer">
        <p>
          Need help? Contact our support team at
          <a href="mailto:support@teepas.com">support@teepas.com</a>
        </p>
      </div>
    </div>
  </body>
</html>
