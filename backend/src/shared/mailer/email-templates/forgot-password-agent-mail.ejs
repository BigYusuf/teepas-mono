<!DOCTYPE html>
<html>
  <head>
    <title>Teepas Agent Password Reset</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        background-color: #fafafa;
        color: #222222;
      }
      a {
        color: #0070f3;
        text-decoration: none;
      }
      h1 {
        font-size: 24px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 15px;
        text-align: center;
      }
      p {
        margin-top: 0;
        margin-bottom: 24px;
      }
      table td {
        vertical-align: top;
      }
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      }
      .email-header {
        background-color: #004aad;
        padding: 24px;
        color: #ffffff;
        text-align: center;
      }
      .email-body {
        padding: 24px;
      }
      .email-footer {
        background-color: #f6f6f6;
        padding: 24px;
        text-align: center;
        font-size: 14px;
        color: #555;
      }
      .button {
        display: inline-block;
        background-color: #004aad;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        padding: 12px 24px;
        border-radius: 4px;
        margin-top: 16px;
      }
      .otp {
        display: inline-block;
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 4px;
        color: #004aad;
        margin: 20px 0;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>Agent Password Reset - Teepas</h1>
      </div>
      <div class="email-body">
        <p>Hello <%= name %>,</p>
        <p>
          We received a request to reset your password for your Teepas
          <strong>Agent Account</strong>. Use the OTP below to securely reset
          your password:
        </p>
        <div class="otp"><%= otp %></div>
        <p>
          This OTP is valid for <strong>5 minutes</strong>. If you didn’t
          request this, you can safely ignore this message.
        </p>
        <p>
          For any assistance, feel free to contact our agent support team.
        </p>
        <a href="mailto:agent-support@teepas.com" class="button">
          Contact Support
        </a>
      </div>
      <div class="email-footer">
        <p>
          Teepas Agent Services — Empowering your property sales.<br />
          <a href="https://www.teepas.com">www.teepas.com</a>
        </p>
      </div>
    </div>
  </body>
</html>
