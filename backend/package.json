{
  "name": "teepas-mono",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "docker-up": "docker compose -f docker-compose.yml up -d",
    "docker-down": "docker compose -f docker-compose.yml down",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "prisma:merge": "node prisma/merge-schema.js",
    "prisma:generate": "npm run prisma:merge && npx prisma format && npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npm run prisma:merge && npx prisma migrate dev",
    "generate:types": "ts-node scripts/generate-types.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "ejs": "^6.0.1",
    "express": "^4.18.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.20.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "path": "^0.12.7",
    "resend": "^6.12.4",
    "slugify": "^1.6.9",
    "tsc": "^2.0.4",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "prisma": "6.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "~5.7.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
